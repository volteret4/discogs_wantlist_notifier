# Credenciales IMAP (mismo buzón de disroot que bandcamp_imap)
IMAP_SERVER=imap.ejemplo.com
IMAP_PORT=993
IMAP_EMAIL=tu@email.com
IMAP_PASSWORD=tu_password_aqui

# Carpetas IMAP a revisar, separadas por "|" (no por espacio: los nombres
# pueden llevar espacios), p.ej.:
IMAP_FOLDERS="Musica.Wantlist Discogs|Musica.Wantlist Discogs.2025 02"

# Bot de Telegram (se puede reutilizar el bot admin de bot_conciertos)
TELEGRAM_BOT_TOKEN=tu_bot_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui
