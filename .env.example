# Credenciales IMAP (mismo buzón de disroot que bandcamp_imap)
IMAP_SERVER=imap.ejemplo.com
IMAP_PORT=993
IMAP_EMAIL=tu@email.com
IMAP_PASSWORD=tu_password_aqui

# Carpetas IMAP a revisar, separadas por "|" (no por espacio: los nombres
# pueden llevar espacios). Por defecto INBOX. En cada carpeta solo se miran
# correos UNSEEN de DISCOGS_FROM cuyo asunto contenga DISCOGS_SUBJECT.
# (Las antiguas carpetas "Musica.Wantlist Discogs*" ya no existen en disroot.)
IMAP_FOLDERS=INBOX
#DISCOGS_FROM=noreply@discogs.com
#DISCOGS_SUBJECT=Wantlist

# Bot de Telegram (se puede reutilizar el bot admin de bot_conciertos)
TELEGRAM_BOT_TOKEN=tu_bot_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# ── docker-compose.yml ──────────────────────────────────────────
# Uid:gid del usuario dueño de esta carpeta (los ficheros que se generan son suyos)
UID_GID=1000:1000
# Zona horaria de los trabajos programados (Ofelia)
TZ=Europe/Madrid
